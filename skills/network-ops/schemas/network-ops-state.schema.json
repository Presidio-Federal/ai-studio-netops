{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "network-ops-state/v3.3",
  "title": "state/network-ops.json",
  "description": "This Network Ops recommendation or GitOps change. Replace in full each invoke. v3.3: change.prescription is the exact edit submit_change.py applies; ci.passed_sha is the last dev SHA whose apply.yml watch passed; release holds the CHG handoff. v3.2: problem_ref, relations[], change.interfaces. 3.1: optional review[].",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated_at",
    "source_agent",
    "status",
    "headline",
    "next_action",
    "mode",
    "problem_ref",
    "finding",
    "change",
    "git",
    "ci",
    "pr",
    "release",
    "relations",
    "keys"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "network-ops-state/v3.3"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_agent": {
      "type": "string",
      "const": "network-ops"
    },
    "status": {
      "type": "string",
      "enum": [
        "recommended",
        "committed",
        "ci_failed",
        "merged",
        "no_change",
        "unknown",
        "blocked",
        "failed"
      ]
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "mode": {
      "type": "string",
      "enum": [
        "recommend",
        "implement"
      ]
    },
    "problem_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^P-[0-9]{8}-[0-9]{2}$",
      "description": "The state/health.json problems[].id this work treats. Set when the ask matches one problem (the Analyzer's order names it, or the operator named its keys or symptom). Null when the ask is not about a charted problem — never guessed."
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "headline",
        "kind",
        "verified_in_git"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "`health:<P-id>` when problem_ref is set; `operator`; or the catalog path of the record the finding came from (state/testing.json, a stamp)."
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "kind": {
          "type": "string",
          "enum": [
            "missing_config",
            "wrong_config",
            "test_bug",
            "other"
          ]
        },
        "verified_in_git": {
          "type": "boolean",
          "description": "true only when the target config body and a passing/canonical peer were both read on dev and the difference named in headline is literally there. false for a hypothesis you could not check in git."
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devices",
        "interfaces",
        "peer",
        "files",
        "summary",
        "operational_ref",
        "monitoring_ref",
        "blast_radius",
        "annotation_ref",
        "prescription"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Exact target hostnames as spelled in inventory/prod.json."
        },
        "interfaces": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^ /]+/[^ ]+$"
          },
          "description": "`<device>/<interface>` for every interface stanza the prescription names as its scope. Empty when the scope is global or a non-interface block."
        },
        "peer": {
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "operational_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^operational/runs/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z\\.json$",
          "description": "Workspace-relative operation record returned by GitOps Change."
        },
        "monitoring_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^operational/runs/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z\\.json$",
          "description": "Workspace-relative operation record returned by Pipeline Monitor."
        },
        "blast_radius": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hosts",
            "applications",
            "services",
            "basis",
            "source_ref"
          ],
          "description": "Mechanical walk of state/relationships.json current edges from change.devices / change.interfaces: connected_to, traverses, flows_to neighbours into hosts; depends_on chains into applications; service depends_on into services. Names without key prefix, sorted. Never a key. references/blast-radius.md.",
          "properties": {
            "hosts": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "applications": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 24,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "services": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "basis": {
              "type": "string",
              "enum": [
                "intended",
                "observed",
                "both",
                "none"
              ]
            },
            "source_ref": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "state/relationships.json",
                null
              ]
            }
          }
        },
        "annotation_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "Identifier returned by grafana_annotations(action=\"create\") after the merge, as a string. null in recommend / review, on any non-merged status, when Grafana is not attached, or when the create failed twice."
        },
        "prescription": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Exact edit for submit_change.py. Null in recommend and review. The script reads this object; nobody retypes it into argv.",
          "required": [
            "targets",
            "operation",
            "lines",
            "old_lines",
            "scope",
            "placement",
            "constraints"
          ],
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Hostnames as spelled in inventory. The script resolves each to one inventory/configs path from github_list_files."
            },
            "operation": {
              "type": "string",
              "enum": [
                "ensure_present",
                "ensure_absent",
                "replace"
              ]
            },
            "lines": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Exact line text, including the leading indent the file must keep. One config line per item."
            },
            "old_lines": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "replace only: the contiguous lines to swap, exact text. Empty for ensure_present and ensure_absent."
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "global, or the exact block header (interface GigabitEthernet4, router bgp 65000, line vty 0 4). line vty with no range matches one line vty block."
            },
            "placement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "end, start, after <exact line>, or before <exact line>. The anchor line is matched inside the scope."
            },
            "constraints": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "commit_sha",
        "html_url"
      ],
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "html_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "ref",
        "run_id",
        "html_url",
        "result",
        "marker",
        "passed_sha"
      ],
      "properties": {
        "workflow": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "html_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pass",
            "fail",
            "unknown",
            "running",
            null
          ]
        },
        "marker": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "passed_sha": {
          "type": [
            "string",
            "null"
          ],
          "description": "Last dev commit SHA whose apply.yml watch returned pass. Release compares the PR head to this. Null until a watch passes."
        }
      }
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "html_url",
        "merged"
      ],
      "properties": {
        "number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "html_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "merged": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "chg_number",
        "status"
      ],
      "properties": {
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "servicenow/requests/<request_id>.json written for this PR. Null until Network Ops writes the request."
        },
        "chg_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pending",
            "waiting",
            "released",
            null
          ],
          "description": "pending while the PR is open and the CHG is not released. A second commit on that PR is a batch."
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/relation"
      },
      "description": "What Network Ops concluded, asserted. Both ends in keys. See references/relations.md for the three rows allowed and when."
    },
    "keys": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(device|interface|site|service|test|control|incident|change|application):[^ ].*$"
      },
      "description": "Exactly: device:<d> for change.devices, interface:<d>/<i> for change.interfaces, every relations[].from and .to. Nothing from prose."
    },
    "review": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/review_row"
      },
      "description": "Review mode only (an open-ended ask with no problem named). Ranked config-class findings from the chart, the five boards, and the configs read on dev. Row 1 is this record's problem_ref / finding / change. Rows owned by another agent carry proposed null. Omit the property outside review mode."
    }
  },
  "$defs": {
    "review_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "problem_ref",
        "source_ref",
        "devices",
        "interfaces",
        "finding",
        "kind",
        "proposed",
        "verified_in_git",
        "owner"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "problem_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^P-[0-9]{8}-[0-9]{2}$",
          "description": "The chart problem this row treats, when one carries the row's device or test key. Null for a board-only finding."
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Where the symptom is: `state/health.json#P-…`, or `health/metadata-<plane>.json#<row scope or device/kind/subject>`."
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interfaces": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^ /]+/[^ ]+$"
          }
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "One line: what the board or chart shows and what git shows for it."
        },
        "kind": {
          "type": "string",
          "enum": [
            "missing_config",
            "wrong_config",
            "unsaved_config",
            "unplanned_change",
            "test_bug",
            "other"
          ]
        },
        "proposed": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600,
          "description": "Exact lines, scope, and placement in one string (`ensure_present 'ip mtu 1400' under interface GigabitEthernet4 on WAN-01`). Null when the row's owner is not Network Ops or git gave no exact difference."
        },
        "verified_in_git": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "enum": [
            "Network Ops",
            "Health Device",
            "Health Monitor",
            "Health ServiceNow",
            "Ops Network Sync",
            "Ops ServiceNow",
            "Compliance Author",
            "Network Design",
            "operator"
          ],
          "description": "Network Ops when the fix is config lines in git. Otherwise the agent (workspace-handoff spelling) or `operator` whose action it is; such a row has proposed null."
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "rel",
        "basis",
        "evidence_ref"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^(device|interface|site|service|test|control|incident|change|application):[^ ].*$"
        },
        "to": {
          "type": "string",
          "pattern": "^(device|interface|site|service|test|control|incident|change|application):[^ ].*$"
        },
        "rel": {
          "type": "string",
          "enum": [
            "depends_on",
            "caused",
            "resolved_by",
            "impacted"
          ]
        },
        "basis": {
          "type": "string",
          "const": "asserted"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "description": "depends_on / caused: the git path of the config you read (`inventory/configs/<file>` as listed on dev). resolved_by / impacted: the PR html_url or the monitoring operational/runs/ path."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rel": {
                "const": "depends_on"
              }
            }
          },
          "then": {
            "properties": {
              "from": {
                "pattern": "^(service|test|application):"
              },
              "to": {
                "pattern": "^(device|interface):"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rel": {
                "const": "caused"
              }
            }
          },
          "then": {
            "properties": {
              "from": {
                "pattern": "^(device|interface):"
              },
              "to": {
                "pattern": "^(test|service|application|incident):"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rel": {
                "const": "resolved_by"
              }
            }
          },
          "then": {
            "properties": {
              "from": {
                "pattern": "^(test|incident):"
              },
              "to": {
                "pattern": "^change:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "rel": {
                "const": "impacted"
              }
            }
          },
          "then": {
            "properties": {
              "from": {
                "pattern": "^change:"
              },
              "to": {
                "pattern": "^application:"
              }
            }
          }
        }
      ]
    }
  }
}
