{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "presentation-deck/v1",
  "title": "<customer>/deck.json",
  "description": "The deck the presentation agent writes, or that restyle decompiles from an attached pptx. A mirror slide stores shapes. Presentation Builder compiles it. keys is always empty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys", "updated_at", "source_agent", "slug", "title", "slides"],
  "properties": {
    "schema": { "type": "string", "const": "presentation-deck/v1" },
    "keys": { "type": "array", "maxItems": 0 },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "presentation" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "layout", "slots"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "slots": { "type": "object" },
        "blocks": { "type": "array" },
        "shapes": {
          "type": "array",
          "maxItems": 80,
          "items": { "$ref": "#/$defs/shape" }
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y", "w", "h"],
      "properties": {
        "kind": { "enum": ["text", "roundRect", "rect", "chevron", "line"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "fill": { "enum": ["card", "tint", "accent", "navy", "white"] },
        "text": { "type": "string" },
        "size": { "type": "number" },
        "bold": { "type": "boolean" },
        "align": { "enum": ["left", "center", "right"] },
        "ink": { "enum": ["navy", "ink", "accent", "white"] }
      }
    }
  }
}
