{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "presentation-deck/v1",
  "title": "<customer>/deck.json",
  "description": "The deck the presentation agent writes with write_file or update_text_block_in_file. Presentation Builder compiles it and does not edit it. keys is always empty; a deck joins nothing in the relationship graph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys", "updated_at", "source_agent", "slug", "title", "slides"],
  "properties": {
    "schema": { "type": "string", "const": "presentation-deck/v1" },
    "keys": { "type": "array", "maxItems": 0 },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "presentation" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "layout", "slots"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "slots": { "type": "object" },
        "blocks": { "type": "array" }
      }
    }
  }
}
