{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance-intel-metadata/v1",
  "title": "compliance/metadata-intel.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys", "schema", "source_agent", "last_visit_id", "last_collected_at"],
  "properties": {
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change):[^ ].*$"}
    },
    "schema": {"type": "string", "const": "compliance-intel-metadata/v1"},
    "source_agent": {"type": "string", "const": "compliance-intel"},
    "last_visit_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
    },
    "last_collected_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
