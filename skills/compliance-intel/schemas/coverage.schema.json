{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage",
  "title": "compliance/coverage.json",
  "description": "Accumulated working state: catalog nist: mappings plus controls Intel has reviewed. Written by Compliance. Not a run result. Not a full NIST dump.",
  "type": "object",
  "required": ["version", "updated_at", "source_agent", "rows", "counts"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "updated_at": {"type": "string"},
    "source_agent": {"type": "string"},
    "oscal_release": {"type": "string"},
    "estate_source": {"type": "string"},
    "git_ref": {"type": "string"},
    "git_paths": {"type": "array", "items": {"type": "string"}},
    "catalog_version": {"type": "string"},
    "platforms": {"type": "array", "items": {"type": "string"}},
    "counts": {
      "type": "object",
      "properties": {
        "covered": {"type": "integer"},
        "partial": {"type": "integer"},
        "gap": {"type": "integer"},
        "unwired": {"type": "integer"},
        "not_applicable": {"type": "integer"}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nist_id", "status", "keys"],
        "properties": {
          "nist_id": {"type": "string"},
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "description": "The control key plus every mapped test key present on this row. Exact source-native names; no inferred entities.",
            "items": {
              "type": "string",
              "pattern": "^(device|interface|site|service|test|control|incident|change|recommendation):[^ ].*$"
            }
          },
          "family_id": {"type": "string"},
          "title": {"type": "string"},
          "net_comp": {"type": "array", "items": {"type": "string"}},
          "live": {"type": "array", "items": {"type": "string"}},
          "static": {"type": "array", "items": {"type": "string"}},
          "platforms": {"type": "array", "items": {"type": "string"}},
          "status": {
            "type": "string",
            "enum": ["covered", "partial", "gap", "unwired", "not_applicable"]
          },
          "partial_why": {"type": ["string", "null"]},
          "suggested_assert": {"type": ["string", "null"]}
        }
      }
    }
  }
}
