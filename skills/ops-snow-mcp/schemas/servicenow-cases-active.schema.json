{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "servicenow-cases-active/v1",
  "title": "servicenow/cases/active.json",
  "description": "Open cases this agent filed or updated, newest first, cap 5. Not a ServiceNow table dump.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys", "updated_at", "source_agent", "status", "headline", "cases"],
  "properties": {
    "schema": { "type": "string", "const": "servicenow-cases-active/v1" },
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change):[^ ].*$" }
    },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "servicenow" },
    "status": { "type": "string", "enum": ["clear", "open", "unknown"] },
    "headline": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "type", "state", "headline", "devices", "source_refs", "updated_at"],
        "properties": {
          "number": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["incident", "change"] },
          "state": { "type": "string", "minLength": 1 },
          "headline": { "type": "string", "minLength": 1 },
          "devices": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "sys_id": { "type": "string" },
          "updated_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
