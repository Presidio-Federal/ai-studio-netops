{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "servicenow-metadata-lab/v1",
  "title": "servicenow/metadata-lab.json",
  "description": "Lab Operator lookup (Kind metadata). Marker and match terms for this lab’s tickets. Not the five-field envelope. Live values live here, not in the prompt. Not health/metadata-servicenow.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_at", "source_agent", "servicenow"],
  "properties": {
    "schema": { "type": "string", "const": "servicenow-metadata-lab/v1" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "ops-snow-mcp" },
    "servicenow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker"],
      "properties": {
        "marker": {
          "type": "string",
          "minLength": 1,
          "description": "Workspace lookup. Text that identifies this lab's tickets."
        },
        "match_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "last_visit_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
        },
        "last_collected_at": { "type": ["string", "null"] }
      }
    },
    "inventory_ref": {
      "type": "string",
      "const": "inventory/prod.json"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servicenow": { "type": "string", "enum": ["user", "discovered"] }
      }
    }
  }
}
