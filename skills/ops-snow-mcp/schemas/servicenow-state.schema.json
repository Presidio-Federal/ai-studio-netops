{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "servicenow-state/v1",
  "title": "state/servicenow.json",
  "description": "Current ServiceNow board plus a capped run history. Open cases are only records this agent filed or updated — not a copy of the instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated_at",
    "source_agent",
    "status",
    "headline",
    "run_count",
    "first_run_at",
    "last_run_at",
    "last_action",
    "open",
    "trend",
    "history",
    "cases"
  ],
  "properties": {
    "schema": { "type": "string", "const": "servicenow-state/v1" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "servicenow" },
    "status": {
      "type": "string",
      "enum": ["clear", "open", "unknown"],
      "description": "clear = no tracked open INC/CHG. open = at least one. unknown = could not confirm in ServiceNow."
    },
    "headline": { "type": "string", "minLength": 1 },
    "run_count": { "type": "integer", "minimum": 1 },
    "first_run_at": { "type": "string", "minLength": 1 },
    "last_run_at": { "type": "string", "minLength": 1 },
    "last_action": {
      "type": "string",
      "enum": ["created", "updated", "assigned", "drafted", "recommended", "noop", "needs_approval", "failed", "board"]
    },
    "last_record": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["incident", "change"] },
        "number": { "type": "string", "minLength": 1 },
        "state": { "type": "string" }
      }
    },
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incidents", "changes", "devices"],
      "properties": {
        "incidents": { "type": "integer", "minimum": 0 },
        "changes": { "type": "integer", "minimum": 0 },
        "devices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Inventory labels this agent's open cases are about."
        }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vs_prior", "note"],
      "properties": {
        "vs_prior": {
          "type": "string",
          "enum": ["first", "unchanged", "worse", "better"]
        },
        "note": { "type": "string", "minLength": 1 },
        "open_incidents_prior": { "type": ["integer", "null"] },
        "open_changes_prior": { "type": ["integer", "null"] }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "description": "Newest first. One row per invoke.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "action", "status", "headline", "open_incidents", "open_changes"],
        "properties": {
          "at": { "type": "string", "minLength": 1 },
          "action": {
            "type": "string",
            "enum": ["created", "updated", "assigned", "drafted", "recommended", "noop", "needs_approval", "failed", "board"]
          },
          "status": { "type": "string", "enum": ["clear", "open", "unknown"] },
          "headline": { "type": "string", "minLength": 1 },
          "open_incidents": { "type": "integer", "minimum": 0 },
          "open_changes": { "type": "integer", "minimum": 0 },
          "devices": { "type": "array", "items": { "type": "string" } },
          "record": { "type": ["string", "null"] }
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "index"],
      "properties": {
        "active": { "type": "string", "const": "servicenow/cases/active.json" },
        "index": { "type": "string", "const": "servicenow/cases/index.json" }
      }
    },
    "inventory": {
      "type": "string",
      "description": "Workspace inventory used to name devices. Usually inventory/prod.json."
    }
  }
}
