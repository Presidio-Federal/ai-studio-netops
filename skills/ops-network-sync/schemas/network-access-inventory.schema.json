{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "network-access-inventory/v3",
  "title": "inventory/prod.json or inventory/dev.json",
  "description": "Canonical accumulating inventory and published access snapshot. Merge in place. Extra keys allowed. Never a failed collect.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "snapshot_id",
    "environment",
    "collected_at",
    "published_at",
    "expires_at",
    "status",
    "coverage",
    "source",
    "infra_sot",
    "lab_title",
    "netbox",
    "device_count",
    "devices",
    "links"
  ],
  "properties": {
    "schema": { "type": "string", "const": "network-access-inventory/v3" },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$",
      "description": "Stamp of this published snapshot. State current_snapshot.snapshot_id must match."
    },
    "environment": { "type": "string", "enum": ["prod", "dev"] },
    "collected_at": {
      "type": "string",
      "description": "When source evidence was collected (UTC)."
    },
    "published_at": {
      "type": "string",
      "description": "When this merged file was written (UTC)."
    },
    "expires_at": {
      "type": "string",
      "description": "After this instant, PAT/access is stale. Inspect allowed; do not treat as current access. Default +26h from collected_at."
    },
    "status": {
      "type": "string",
      "enum": ["complete", "partial"],
      "description": "Collection quality of this published snapshot. Failed collects are not published."
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cml", "document", "api", "netbox", "excel", "other"]
        },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "infra_sot": { "type": "string", "enum": ["git", "netbox"] },
    "lab_title": { "type": "string", "minLength": 1 },
    "lab_id": { "type": ["string", "null"] },
    "netbox": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tenant", "site"],
      "properties": {
        "tenant": { "type": "string", "minLength": 1 },
        "site": { "type": "string", "minLength": 1 }
      }
    },
    "device_count": { "type": "integer", "minimum": 0 },
    "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "devices_discovered",
        "devices_inspected",
        "accessible_devices",
        "missing_device_info",
        "missing_restconf",
        "missing_ssh"
      ],
      "properties": {
        "state": { "type": "string", "enum": ["complete", "partial"] },
        "devices_discovered": { "type": "integer", "minimum": 0 },
        "devices_inspected": { "type": "integer", "minimum": 0 },
        "accessible_devices": { "type": "integer", "minimum": 0 },
        "missing_device_info": { "type": "array", "items": { "type": "string" } },
        "missing_restconf": { "type": "array", "items": { "type": "string" } },
        "missing_ssh": { "type": "array", "items": { "type": "string" } }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string" },
        "credential_ref": { "type": ["string", "null"] }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "platform",
        "role",
        "tags",
        "operational_state",
        "agent_access",
        "access",
        "source_metadata"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "operational_state": { "type": "string", "minLength": 1 },
        "agent_access": { "type": "boolean" },
        "access": {
          "type": "object",
          "additionalProperties": true,
          "required": ["restconf", "ssh"],
          "properties": {
            "restconf": {
              "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/endpoint" }]
            },
            "ssh": {
              "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/endpoint" }]
            }
          }
        },
        "source_metadata": { "type": "object" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": true,
      "required": ["a_device", "a_interface", "b_device", "b_interface"],
      "properties": {
        "a_device": { "type": "string", "minLength": 1 },
        "a_interface": { "type": "string", "minLength": 1 },
        "b_device": { "type": "string", "minLength": 1 },
        "b_interface": { "type": "string", "minLength": 1 }
      }
    }
  }
}
