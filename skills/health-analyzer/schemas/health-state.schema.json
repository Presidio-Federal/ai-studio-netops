{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-state/v5",
  "title": "state/health.json",
  "description": "Health Analyzer SOAP rollup (Kind state). Sole writer health-analyzer. Envelope status is worst of complete/partial thousandeyes, splunk, iosxe. ServiceNow does not vote. Freshness from observation checked_at + ttl_hours (default 26). series points copied from visit metrics. soap is S/O/A/P; plan is a forward step (named nurse visit, refer Ops/Design, or none) — not an inspect path for a stamp already read. assessment and trend_analysis are this agent's verdict — not pasted visit headlines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated_at",
    "source_agent",
    "status",
    "headline",
    "next_action",
    "mode",
    "analyzed_at",
    "coverage",
    "freshness",
    "consults",
    "series",
    "assessment",
    "trend_analysis",
    "soap",
    "dispatched",
    "read"
  ],
  "properties": {
    "schema": { "type": "string", "const": "health-state/v5" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "health-analyzer" },
    "status": {
      "type": "string",
      "enum": ["ok", "degraded", "unknown", "partial", "stale_chart"],
      "description": "First match. ServiceNow does not vote. unknown when no vital slip is usable. stale_chart when a vital plane is clock-stale or this invoke dispatched one. degraded when a current vital consult is degraded. partial when a vital plane is missing or its coverage is unavailable while another vital slip is usable. ok otherwise."
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "description": "One line of assessment.opinion. Analyzer verdict, not a visit headline or metrics dump."
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "description": "Same string as soap.plan. Named nurse visit, refer Network Ops or Network Design, or none. Not an inspect path. Not a SKU, ticket, git change, or test plan."
    },
    "mode": {
      "type": "string",
      "enum": ["assess-now", "refresh-then-assess"]
    },
    "analyzed_at": { "type": "string", "minLength": 1 },
    "coverage": { "$ref": "#/$defs/plane_coverage" },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thousandeyes", "splunk", "iosxe", "servicenow"],
      "properties": {
        "thousandeyes": { "$ref": "#/$defs/freshness_row" },
        "splunk": { "$ref": "#/$defs/freshness_row" },
        "iosxe": { "$ref": "#/$defs/freshness_row" },
        "servicenow": { "$ref": "#/$defs/freshness_row" }
      }
    },
    "consults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thousandeyes": { "$ref": "#/$defs/consult" },
        "splunk": { "$ref": "#/$defs/consult" },
        "iosxe": { "$ref": "#/$defs/consult" },
        "servicenow": { "$ref": "#/$defs/consult_servicenow" }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thousandeyes", "splunk", "iosxe", "servicenow"],
      "properties": {
        "thousandeyes": { "$ref": "#/$defs/series_plane" },
        "splunk": { "$ref": "#/$defs/series_plane" },
        "iosxe": { "$ref": "#/$defs/series_plane" },
        "servicenow": { "$ref": "#/$defs/series_plane" }
      }
    },
    "assessment": { "$ref": "#/$defs/assessment" },
    "trend_analysis": { "$ref": "#/$defs/trend_analysis" },
    "soap": { "$ref": "#/$defs/soap" },
    "dispatched": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plane", "agent", "invoked_at"],
        "properties": {
          "plane": {
            "type": "string",
            "enum": ["thousandeyes", "splunk", "iosxe", "servicenow"]
          },
          "agent": { "type": "string", "minLength": 1 },
          "invoked_at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "read": {
      "type": "array",
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "coverage_state": {
      "type": "string",
      "enum": ["complete", "unavailable", "not_requested", "partial"]
    },
    "plane_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thousandeyes", "splunk", "iosxe", "servicenow"],
      "properties": {
        "thousandeyes": { "$ref": "#/$defs/coverage_state" },
        "splunk": { "$ref": "#/$defs/coverage_state" },
        "iosxe": { "$ref": "#/$defs/coverage_state" },
        "servicenow": { "$ref": "#/$defs/coverage_state" }
      }
    },
    "freshness_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "observed_at", "ttl_hours"],
      "properties": {
        "state": { "type": "string", "enum": ["current", "stale", "missing"] },
        "observed_at": { "type": ["string", "null"] },
        "ttl_hours": { "type": "number", "const": 26 }
      }
    },
    "series_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "watermark", "points"],
      "properties": {
        "window": { "type": "integer", "const": 10 },
        "watermark": {
          "type": ["string", "null"],
          "description": "Last watch_id folded in. Re-invoke with no newer stamps is a no-op on points."
        },
        "points": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["at", "scope"],
            "properties": {
              "at": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unhealthy", "healthy", "contradictions", "opinion"],
      "description": "This agent's verdict from all four planes and the series. Not pasted visit headlines.",
      "properties": {
        "unhealthy": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "healthy": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "contradictions": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "opinion": {
          "type": "string",
          "minLength": 1,
          "description": "One verdict. Do not invent an unobserved root cause."
        }
      }
    },
    "trend_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative", "flips"],
      "description": "What changed over the series window. Analyzer writing, not a metrics dump.",
      "properties": {
        "narrative": { "type": "string", "minLength": 1 },
        "flips": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "soap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjective", "objective", "assessment", "plan"],
      "description": "Attending SOAP on this chart. Nurses do not write this object.",
      "properties": {
        "subjective": {
          "type": "string",
          "minLength": 1,
          "description": "Why this analysis ran: the operator ask, or scheduled assess-now / refresh-then-assess."
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "description": "What the lab slips and series measured this visit. Coverage and freshness belong here. Stamp paths stay on consults.*.source_ref — do not put inspect instructions here."
        },
        "assessment": {
          "type": "string",
          "minLength": 1,
          "description": "Same verdict as assessment.opinion. One sentence from all four planes and the series."
        },
        "plan": {
          "type": "string",
          "minLength": 1,
          "description": "Forward clinical step only: another named nurse visit, refer Network Ops or Network Design, or none. Not 'Inspect health/...json'. Not a SKU, git change, or test plan."
        }
      }
    },
    "consult": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "watch_id",
        "observed_at",
        "status",
        "trend",
        "trend_note",
        "impression",
        "evidence_for",
        "evidence_against",
        "source_ref",
        "inspect_when"
      ],
      "properties": {
        "watch_id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
        "trend": {
          "type": "string",
          "enum": ["first", "unchanged", "worse", "better"]
        },
        "trend_note": {
          "type": "string",
          "minLength": 1,
          "description": "This agent's read of this plane's series over the window."
        },
        "impression": {
          "type": "string",
          "minLength": 1,
          "description": "This agent's verdict for this plane. Not the visit headline."
        },
        "evidence_for": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_against": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_ref": { "type": "string", "minLength": 1 },
        "inspect_when": { "type": "string", "minLength": 1 }
      }
    },
    "consult_servicenow": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "watch_id",
        "observed_at",
        "status",
        "trend",
        "trend_note",
        "impression",
        "evidence_for",
        "evidence_against",
        "source_ref",
        "inspect_when",
        "collection_status",
        "ticket_history"
      ],
      "properties": {
        "watch_id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
        },
        "observed_at": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
        "trend": {
          "type": "string",
          "enum": ["first", "unchanged", "worse", "better"]
        },
        "trend_note": {
          "type": "string",
          "minLength": 1,
          "description": "This agent's read of this plane's series over the window."
        },
        "impression": {
          "type": "string",
          "minLength": 1,
          "description": "This agent's verdict for this plane. Not the visit headline."
        },
        "evidence_for": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_against": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_ref": { "type": "string", "minLength": 1 },
        "inspect_when": { "type": "string", "minLength": 1 },
        "collection_status": {
          "type": "string",
          "enum": ["complete", "unavailable", "partial"]
        },
        "threads": {
          "type": "array",
          "maxItems": 16,
          "description": "Copied from the ServiceNow stamp. Each row is keys plus the nurse's note.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keys", "note"],
            "properties": {
              "keys": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ticket_history": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern", "summary", "related_records", "prior_resolution"],
          "properties": {
            "pattern": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "related_records": {
              "type": "array",
              "maxItems": 10,
              "items": { "type": "string" }
            },
            "prior_resolution": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
