{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-metadata-thousandeyes/v1",
  "title": "health/metadata-thousandeyes.json",
  "description": "ThousandEyes lookup inventory (Kind metadata). Health Monitor TE visit only. Not the five-field envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_at", "source_agent", "thousandeyes"],
  "properties": {
    "schema": { "type": "string", "const": "health-metadata-thousandeyes/v1" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "health-monitor" },
    "thousandeyes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests"],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "account_name": { "type": ["string", "null"] },
        "window": { "type": "string" },
        "result_type": { "type": "string" },
        "last_visit_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
        },
        "last_collected_at": { "type": ["string", "null"] },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test_id"],
            "properties": {
              "test_id": { "type": "string", "minLength": 1 },
              "test_name": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thousandeyes": {
          "type": "string",
          "enum": ["user", "discovered"]
        }
      }
    }
  }
}
