{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-splunk-check/v2",
  "title": "health/splunk/YYYY-MM-DDTHH-MM-SSZ.json",
    "description": "Splunk lab slip (Kind observation). The first visit is the baseline: one metrics row per device that logged, plus readings for BGP, link, config, and auth. Later visits diff those rows. No window-wide event census and no raw syslog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "watch_id",
    "checked_at",
    "ok",
    "status",
    "headline",
    "window",
    "coverage",
    "metrics",
    "vs_prior"
  ],
  "properties": {
    "schema": { "type": "string", "const": "health-splunk-check/v2" },
    "source": { "type": "string", "const": "splunk" },
    "watch_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
    },
    "checked_at": { "type": "string", "minLength": 1 },
    "ok": { "type": ["boolean", "null"] },
    "status": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
    "headline": { "type": "string", "minLength": 1 },
    "window": { "type": "string", "minLength": 1 },
    "window_start": { "type": ["string", "null"] },
    "window_end": { "type": ["string", "null"] },
    "query_profile": { "type": "string" },
    "scope": { "type": "string" },
    "prior_observation": { "type": ["string", "null"] },
    "coverage": { "$ref": "#/$defs/coverage" },
    "vs_prior": { "$ref": "#/$defs/vs_prior" },
    "concerns": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/entity_ref" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric_row" }
    },
    "readings": {
      "type": "array",
      "maxItems": 64,
      "description": "One subject line per device and signal this window. The next visit diffs these against the prior stamp. Omit raw syslog.",
      "items": { "$ref": "#/$defs/reading" }
    }
  },
  "$defs": {
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "description": "workspace-handoff entity reference. Do not copy the referenced object. Do not invent id.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "device",
            "interface",
            "site",
            "service",
            "test",
            "control",
            "incident",
            "change",
            "recommendation"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] }
      }
    },
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_watch_id", "delta", "changed"],
      "description": "Diff against the prior stamp of this source. First visit: prior_watch_id null, delta first, changed []. Later visits: changed lists only what moved.",
      "properties": {
        "prior_watch_id": { "type": ["string", "null"] },
        "delta": {
          "type": "string",
          "enum": ["first", "unchanged", "worse", "better"]
        },
        "changed": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "unavailable", "not_requested", "partial"]
        },
        "detail": { "type": "string" }
      }
    },
    "metric_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "scope", "name", "bgp_adjchange", "link_updown", "config_i"],
      "properties": {
        "at": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1, "description": "device:<name> for each device that logged. window only when no device logged anything but DHCP." },
        "name": {
          "type": ["string", "null"],
          "description": "IOS hostname from the syslog body. Same spelling as inventory when that name exists. Null on a window row."
        },
        "bgp_adjchange": { "type": ["integer", "null"] },
        "link_updown": { "type": ["integer", "null"] },
        "config_i": { "type": ["integer", "null"] }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "subject", "count", "keys", "note"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "description": "Every join key in this tool payload. type:name.",
          "items": { "type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change|recommendation):.+" }
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["bgp", "link", "config", "auth"] },
        "subject": { "type": "string", "minLength": 1, "description": "The fact to diff next visit. BGP: neighbor and Up/Down. Link: interface and up/down. Config: who changed it. Auth: the mnemonic, including AUTH_PASSED." },
        "count": { "type": "integer", "minimum": 1 },
        "note": { "type": "string", "minLength": 1, "description": "Nurse's opinion for the higher agent. What this signal did since the prior stamp, with the neighbor or interface and whether config was committed. A sentence that only says something changed is not a note." }
      }
    }
  }
}
