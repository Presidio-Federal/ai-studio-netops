{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-thousandeyes-check/v2",
  "title": "health/thousandeyes/YYYY-MM-DDTHH-MM-SSZ.json",
    "description": "ThousandEyes lab slip (Kind observation). One metrics row per test and agent: test name, loss, latency, jitter, rounds. vs_prior.changed is the diff against the prior stamp; empty on the first visit. path_summary is the worst test after path-vis. Do not store every round.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "watch_id",
    "checked_at",
    "ok",
    "status",
    "headline",
    "window",
    "coverage",
    "metrics",
    "vs_prior"
  ],
  "properties": {
    "schema": { "type": "string", "const": "health-thousandeyes-check/v2" },
    "source": { "type": "string", "const": "thousandeyes" },
    "watch_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
    },
    "checked_at": { "type": "string", "minLength": 1 },
    "ok": { "type": ["boolean", "null"] },
    "status": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
    "headline": { "type": "string", "minLength": 1 },
    "window": { "type": "string", "minLength": 1 },
    "window_start": { "type": ["string", "null"] },
    "window_end": { "type": ["string", "null"] },
    "prior_observation": { "type": ["string", "null"] },
    "coverage": { "$ref": "#/$defs/coverage" },
    "vs_prior": { "$ref": "#/$defs/vs_prior" },
    "concerns": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/entity_ref" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric_row" }
    },
    "alerts": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "firing": { "type": "integer" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": ["string", "null"] },
              "test_id": { "type": ["string", "null"] },
              "state": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "path_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Standing-order path-vis on the worst test only. Omit when path-vis did not run.",
      "required": ["test_id"],
      "properties": {
        "test_id": { "type": "string", "minLength": 1 },
        "test_name": { "type": "string" },
        "hops": { "type": ["integer", "null"] },
        "last_error_hop": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "description": "workspace-handoff entity reference. Do not copy the referenced object. Do not invent id.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "device",
            "interface",
            "site",
            "service",
            "test",
            "control",
            "incident",
            "change",
            "recommendation"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] }
      }
    },
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_watch_id", "delta", "changed"],
      "description": "Diff against the prior stamp of this source. First visit: prior_watch_id null, delta first, changed []. Later visits: changed lists only what moved.",
      "properties": {
        "prior_watch_id": { "type": ["string", "null"] },
        "delta": {
          "type": "string",
          "enum": ["first", "unchanged", "worse", "better"]
        },
        "changed": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "unavailable", "not_requested", "partial"]
        },
        "detail": { "type": "string" }
      }
    },
    "metric_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "scope",
        "name",
        "agent",
        "loss_pct",
        "latency_ms_p95",
        "latency_ms_avg",
        "jitter_ms",
        "ok_rounds",
        "error_rounds",
        "keys",
        "note"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "description": "Every join key in this tool payload. type:name. test:<id> when the API returned a test id. device: when the payload names an inventory device.",
          "items": { "type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change|recommendation):.+" }
        },
        "at": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1, "description": "test:<testId>/<agentName>. Stable key for the next visit's diff." },
        "name": { "type": ["string", "null"], "description": "API testName. Null when that test returned no result." },
        "agent": { "type": ["string", "null"], "description": "Agent name on the result. Null when the test returned no result." },
        "server": { "type": ["string", "null"], "description": "serverIp on the result." },
        "loss_pct": { "type": ["number", "null"], "description": "Mean loss on ok rounds this window." },
        "latency_ms_p95": { "type": ["number", "null"] },
        "latency_ms_avg": { "type": ["number", "null"] },
        "jitter_ms": { "type": ["number", "null"] },
        "ok_rounds": { "type": ["integer", "null"] },
        "error_rounds": { "type": ["integer", "null"] },
        "note": { "type": "string", "minLength": 1, "description": "Nurse's opinion for the higher agent. Loss, latency, jitter, ok and error rounds, and what moved since the prior stamp. Include the path-vis hop when this row is the worst test. A sentence that only says loss rose is not a note." }
      }
    }
  }
}
