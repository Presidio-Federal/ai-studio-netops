{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-servicenow-check/v2",
  "title": "health/servicenow/YYYY-MM-DDTHH-MM-SSZ.json",
  "description": "ServiceNow lab slip (Kind observation). Ticket counts are not a network vital. Vitals + vs_prior + coverage. Omit incidents[]/changes[] unless they add numbers not in metrics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "watch_id",
    "checked_at",
    "ok",
    "status",
    "headline",
    "window",
    "coverage",
    "metrics",
    "vs_prior"
  ],
  "properties": {
    "schema": { "type": "string", "const": "health-servicenow-check/v2" },
    "source": { "type": "string", "const": "servicenow" },
    "watch_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
    },
    "checked_at": { "type": "string", "minLength": 1 },
    "ok": { "type": ["boolean", "null"] },
    "status": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
    "headline": { "type": "string", "minLength": 1 },
    "window": { "type": "string", "minLength": 1 },
    "prior_observation": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "vs_prior": { "$ref": "#/$defs/vs_prior" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric_row" }
    },
    "open_incidents": { "type": ["integer", "null"] },
    "open_changes": { "type": ["integer", "null"] },
    "open_p1p2": { "type": ["integer", "null"] },
    "out_of_scope_open": { "type": ["integer", "null"] },
    "incidents": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/ticket_row" }
    },
    "changes": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/ticket_row" }
    },
    "recent": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/ticket_row" }
    }
  },
  "$defs": {
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_watch_id", "delta", "changed"],
      "description": "This visit vs the last stamp of this source. Not a ticket dump.",
      "properties": {
        "prior_watch_id": { "type": ["string", "null"] },
        "delta": {
          "type": "string",
          "enum": ["first", "unchanged", "worse", "better"]
        },
        "changed": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "unavailable", "not_requested", "partial"]
        },
        "detail": { "type": "string" }
      }
    },
    "metric_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "scope",
        "open_incidents",
        "open_changes",
        "open_p1p2",
        "out_of_scope_open"
      ],
      "properties": {
        "at": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "open_incidents": { "type": ["integer", "null"] },
        "open_changes": { "type": ["integer", "null"] },
        "open_p1p2": { "type": ["integer", "null"] },
        "out_of_scope_open": { "type": ["integer", "null"] }
      }
    },
    "ticket_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "number": { "type": "string", "minLength": 1 },
        "sys_id": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "urgency": { "type": ["string", "null"] },
        "impact": { "type": ["string", "null"] },
        "short_description": { "type": ["string", "null"] },
        "opened_at": { "type": ["string", "null"] },
        "devices": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "scope": { "type": "string", "enum": ["demo", "out_of_scope"] },
        "scope_reason": { "type": ["string", "null"] }
      }
    }
  }
}
