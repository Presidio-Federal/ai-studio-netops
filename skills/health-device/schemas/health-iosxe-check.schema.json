{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-iosxe-check/v2",
  "title": "health/iosxe/YYYY-MM-DDTHH-MM-SSZ.json",
    "description": "IOS-XE lab slip (Kind observation). metrics are per-device counts. readings are each admin-up interface and each BGP neighbor (name, subject, state). The next visit diffs readings. vs_prior.changed is only what moved; empty on the first visit. No RESTCONF body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "watch_id",
    "checked_at",
    "ok",
    "status",
    "headline",
    "window",
    "coverage",
    "metrics",
    "vs_prior"
  ],
  "properties": {
    "schema": { "type": "string", "const": "health-iosxe-check/v2" },
    "source": { "type": "string", "const": "iosxe" },
    "watch_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
    },
    "checked_at": { "type": "string", "minLength": 1 },
    "ok": { "type": ["boolean", "null"] },
    "status": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
    "headline": { "type": "string", "minLength": 1 },
    "window": { "type": "string", "minLength": 1 },
    "prior_observation": { "type": ["string", "null"] },
    "coverage": { "$ref": "#/$defs/coverage" },
    "vs_prior": { "$ref": "#/$defs/vs_prior" },
    "concerns": {
      "type": "array",
      "maxItems": 8,
      "description": "One device entity-ref when a metric on that device is non-zero. Omit healthy devices.",
      "items": { "$ref": "#/$defs/entity_ref" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric_row" }
    },
    "readings": {
      "type": "array",
      "maxItems": 64,
      "description": "Admin-up interfaces and BGP neighbors measured this visit. Same name spelling as inventory. The next visit diffs state, errors, and prefixes. Omit admin-down idle interfaces.",
      "items": { "$ref": "#/$defs/reading" }
    },
    "skipped_reason": { "type": ["string", "null"] }
  },
  "$defs": {
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "description": "workspace-handoff entity reference. Do not copy the referenced object. Do not invent id.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "device",
            "interface",
            "site",
            "service",
            "test",
            "control",
            "incident",
            "change",
            "recommendation"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": ["string", "null"] },
        "source_ref": { "type": ["string", "null"] }
      }
    },
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_watch_id", "delta", "changed"],
      "description": "Diff against the prior IOS-XE stamp. First visit: prior_watch_id null, delta first, changed []. Later visits: changed lists only readings that moved.",
      "properties": {
        "prior_watch_id": { "type": ["string", "null"] },
        "delta": {
          "type": "string",
          "enum": ["first", "unchanged", "worse", "better"]
        },
        "changed": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "unavailable", "not_requested", "partial"]
        },
        "detail": { "type": "string" }
      }
    },
    "metric_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "scope",
        "oper_not_ready",
        "bgp_not_established",
        "in_errors",
        "in_discards",
        "num_flaps"
      ],
      "properties": {
        "at": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "oper_not_ready": { "type": ["integer", "null"] },
        "bgp_not_established": { "type": ["integer", "null"] },
        "in_errors": { "type": ["integer", "null"] },
        "in_discards": { "type": ["integer", "null"] },
        "num_flaps": { "type": ["integer", "null"] }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "subject", "state"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Device name as inventory/prod.json writes it." },
        "kind": { "type": "string", "enum": ["interface", "bgp"] },
        "subject": { "type": "string", "minLength": 1, "description": "Interface name as the device reports it, or the BGP neighbor id." },
        "state": { "type": ["string", "null"] },
        "in_errors": { "type": ["integer", "null"] },
        "in_discards": { "type": ["integer", "null"] },
        "num_flaps": { "type": ["integer", "null"] },
        "prefixes_received": { "type": ["integer", "null"] }
      }
    }
  }
}
