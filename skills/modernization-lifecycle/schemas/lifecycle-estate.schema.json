{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifecycle-estate/v2",
  "title": "state/lifecycle.json",
  "description": "Consolidated estate. Modernization Analysis writes identity, confidence, assessment, and plan (cost + timeline). Modernization Lifecycle merges vendor research. Five-field envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated_at",
    "source_agent",
    "status",
    "headline",
    "next_action",
    "items",
    "coverage",
    "dispatched",
    "recommendations",
    "guidance",
    "assessment",
    "plan",
    "roadmap_ref"
  ],
  "properties": {
    "schema": { "type": "string", "const": "lifecycle-estate/v2" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": {
      "type": "string",
      "enum": ["modernization-analysis", "modernization-lifecycle"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "stale", "unknown"]
    },
    "headline": { "type": "string", "minLength": 1 },
    "next_action": { "type": ["string", "null"] },
    "dispatched": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent", "invoked_at"],
        "properties": {
          "agent": { "type": "string", "const": "modernization-lifecycle" },
          "invoked_at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_count", "with_eox", "with_psirt", "with_cost", "with_software"],
      "properties": {
        "item_count": { "type": "integer", "minimum": 0 },
        "with_eox": { "type": "integer", "minimum": 0 },
        "with_psirt": { "type": "integer", "minimum": 0 },
        "with_cost": { "type": "integer", "minimum": 0 },
        "with_software": { "type": "integer", "minimum": 0 }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/recommendation" }
    },
    "guidance": { "$ref": "#/$defs/guidance" },
    "assessment": { "$ref": "#/$defs/assessment" },
    "plan": { "$ref": "#/$defs/plan" },
    "roadmap_ref": {
      "type": ["string", "null"],
      "description": "Catalog path of the roadmap markdown. lifecycle/roadmap.md once written."
    },
    "goals": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/goal" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_move", "can_wait", "contradictions", "opinion"],
      "description": "Copied through from Modernization Analysis. Do not invent.",
      "properties": {
        "must_move": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1 }
        },
        "can_wait": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1 }
        },
        "contradictions": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "opinion": { "type": "string", "minLength": 1 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cost", "timeline", "opinion"],
      "description": "Copied through from Modernization Analysis. Do not invent.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "asking", "draft", "ready"]
        },
        "cost": { "$ref": "#/$defs/plan_cost" },
        "timeline": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/plan_stage" }
        },
        "opinion": { "type": "string", "minLength": 1 }
      }
    },
    "plan_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "list_total", "priced_qty", "unpriced_qty", "notes"],
      "properties": {
        "currency": { "type": ["string", "null"] },
        "list_total": { "type": ["string", "null"] },
        "priced_qty": { "type": "integer", "minimum": 0 },
        "unpriced_qty": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "plan_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "stage", "pids", "window", "summary"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "stage": {
          "type": "string",
          "enum": ["order", "stage", "deploy", "schedule", "cutover"]
        },
        "pids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "window": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updated_at",
        "identity_confidence",
        "research_confidence",
        "objectives_status",
        "understood",
        "answers",
        "open_asks"
      ],
      "properties": {
        "updated_at": { "type": ["string", "null"] },
        "identity_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"],
          "description": "Worst items[].source.reliability this estate."
        },
        "research_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low", "stale", "unknown"]
        },
        "objectives_status": {
          "type": "string",
          "enum": ["missing", "partial", "stated"]
        },
        "understood": {
          "type": "string",
          "description": "What we know about the current environment. Not a canned line."
        },
        "answers": {
          "type": "string",
          "description": "Operator objectives as they stated them. Empty if none yet."
        },
        "open_asks": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reliability", "ref"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["live", "inventory", "cmdb", "upload", "verbal"]
        },
        "reliability": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at",
        "priority",
        "summary",
        "why",
        "evidence_refs",
        "next_step"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "next_step": { "type": "string", "minLength": 1 }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at",
        "updated_at",
        "status",
        "title",
        "next_step",
        "owner"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^GOAL-[0-9]+$" },
        "created_at": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["open", "in_flight", "done", "blocked"]
        },
        "title": { "type": "string", "minLength": 1 },
        "next_step": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "quantity",
        "devices",
        "summary",
        "source",
        "recommended_replacement",
        "recommended_software",
        "list_cost_per_unit",
        "total_list_cost",
        "end_of_support",
        "end_of_software_support",
        "vulnerabilities",
        "psirts",
        "detail_ref",
        "updated_at"
      ],
      "properties": {
        "pid": {
          "type": "string",
          "minLength": 1,
          "description": "Product id from evidence (device_type, node_definition, serial PID, or operator). Not inferred from hostname."
        },
        "pid_source": {
          "type": "string",
          "enum": ["serial", "netbox", "device_type", "upload", "verbal", "unknown"]
        },
        "quantity": { "type": "integer", "minimum": 0 },
        "devices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "software_versions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sample_device": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "recommended_replacement": {
          "type": ["string", "null"],
          "description": "Hardware SKU from Cisco EoX only. Not a software train. Not the operator pick."
        },
        "selected_replacement": {
          "type": ["string", "null"],
          "description": "SKU the operator named. Lives only on this row. Lifecycle prices this. Never written onto the item file."
        },
        "selected_replacement_source": {
          "type": ["string", "null"],
          "description": "operator when selected_replacement is set. Otherwise null."
        },
        "replacement_family": {
          "type": ["string", "null"],
          "description": "Cisco family-level migration when EoX named no single SKU."
        },
        "replacement_candidates": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "replacement_ask": {
          "type": ["string", "null"],
          "description": "What Lifecycle needs from the operator to price. Copied to guidance.open_asks."
        },
        "recommended_software": {
          "type": ["string", "null"],
          "description": "Software train/version Cisco returned (EoX-by-release or PSIRT Software Checker). Never invented."
        },
        "list_cost_per_unit": { "type": ["string", "null"] },
        "total_list_cost": { "type": ["string", "null"] },
        "currency": { "type": ["string", "null"] },
        "end_of_sale": { "type": ["string", "null"] },
        "end_of_support": { "type": ["string", "null"] },
        "end_of_software_support": { "type": ["string", "null"] },
        "end_of_security_vuln_support": { "type": ["string", "null"] },
        "vulnerabilities": {
          "type": "array",
          "maxItems": 15,
          "items": { "$ref": "#/$defs/advisory" }
        },
        "psirts": {
          "type": "array",
          "maxItems": 15,
          "items": { "$ref": "#/$defs/advisory" }
        },
        "detail_ref": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 },
        "expires_at": { "type": ["string", "null"] },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eox": { "type": "string", "enum": ["complete", "partial", "missing", "unavailable"] },
            "software": { "type": "string", "enum": ["complete", "partial", "missing", "unavailable", "skipped"] },
            "psirt": { "type": "string", "enum": ["complete", "partial", "missing", "unavailable"] },
            "ccw": { "type": "string", "enum": ["complete", "partial", "missing", "unavailable", "skipped"] },
            "nvd": { "type": "string", "enum": ["complete", "partial", "missing", "unavailable", "skipped"] }
          }
        }
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "severity": { "type": ["string", "null"] },
        "cve": { "type": ["string", "null"] },
        "cvss": { "type": ["string", "null"] }
      }
    }
  }
}
