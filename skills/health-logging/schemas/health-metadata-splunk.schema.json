{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-metadata-splunk/v3",
  "title": "health/metadata-splunk.json",
  "description": "Splunk SOAP summary (Kind metadata). Health Logging visit only. Written after the stamp. Lookup fields the next visit needs, the proof path, and four short sentences. Not the row set. Not the tags. Not series[]. Not visits[]. Not the five-field envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys", "schema", "updated_at", "source_agent", "splunk"],
  "properties": {
    "keys": {
      "type": "array",
      "maxItems": 0,
      "description": "Empty. Tags live on the stamp."
    },
    "schema": { "type": "string", "const": "health-metadata-splunk/v3" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "health-logging" },
    "splunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "sourcetype", "window", "collected_through", "last_visit_id", "last_collected_at", "baseline_visit_id", "proof", "status", "coverage", "delta", "soap"],
      "properties": {
        "index": { "type": "string", "minLength": 1 },
        "sourcetype": { "type": "string", "minLength": 1 },
        "window": { "type": "string", "minLength": 1, "description": "Bounded window for S1 counts. Default 1h. Not the watermark." },
        "collected_through": {
          "type": ["string", "null"],
          "description": "ISO-8601 UTC watermark: the last event time collected. Next visit's earliest_time. Never moves backward; not advanced on a failed search."
        },
        "last_visit_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
        },
        "last_collected_at": { "type": ["string", "null"] },
        "baseline_visit_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
        },
        "proof": {
          "type": "string",
          "pattern": "^health/splunk/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z\\.json$",
          "description": "The stamp that holds this visit's rows, delta, and tags."
        },
        "status": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
        "coverage": { "type": "string", "enum": ["complete", "partial", "unavailable"] },
        "delta": { "type": "string", "enum": ["first", "unchanged", "worse", "better", "changed"] },
        "source_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "entries"],
          "properties": {
            "version": { "type": "integer" },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "reporting", "observed"],
                "properties": {
                  "name": { "type": "string" },
                  "reporting": { "type": ["string", "null"], "enum": ["expected", "idle_ok", null] },
                  "observed": { "type": "boolean" }
                }
              }
            }
          }
        },
        "hosts": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Operator-pinned map of a syslog host address to the exact inventory/prod.json device name. Empty object when nothing is pinned."
        },
        "soap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subjective", "objective", "assessment", "plan"],
          "properties": {
            "subjective": { "type": "string", "minLength": 1, "maxLength": 400, "description": "Why this visit ran." },
            "objective": { "type": "string", "minLength": 1, "maxLength": 400, "description": "What this window measured and how it differs from the prior stamp. Names the proof path. No row table." },
            "assessment": { "type": "string", "minLength": 1, "maxLength": 400, "description": "One verdict. Silence is not a forwarding failure." },
            "plan": { "type": "string", "minLength": 1, "maxLength": 400, "description": "The next check, or none." }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "splunk": { "type": "string", "enum": ["user", "discovered"] } }
    }
  }
}
