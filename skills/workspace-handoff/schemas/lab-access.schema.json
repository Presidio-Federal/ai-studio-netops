{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab-access",
  "title": "lab-access.json",
  "description": "Device names and CML PAT ports for both labs, captured once so other agents do not each re-query the controller. PAT ports are reassigned on every lab rebuild, so this file is only trustworthy for the session that wrote it — check updated_at before using it.",
  "type": "object",
  "required": [
    "version",
    "updated_at",
    "source_agent",
    "status",
    "headline",
    "next_action",
    "controller",
    "labs"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_agent": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["OK", "PARTIAL", "STALE"],
      "description": "PARTIAL when only one lab was captured or some nodes had no PAT port."
    },
    "headline": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1},
    "controller": {
      "type": "string",
      "minLength": 1,
      "description": "CML controller host these ports belong to."
    },
    "source": {
      "type": "string",
      "enum": ["cml_mcp", "github_file"],
      "description": "Where the ports came from, so a reader can judge freshness."
    },
    "labs": {
      "type": "object",
      "description": "Keyed by lab role. A hostname can appear in both with different ports.",
      "properties": {
        "prod": {"$ref": "#/$defs/lab"},
        "dev": {"$ref": "#/$defs/lab"}
      }
    }
  },
  "$defs": {
    "lab": {
      "type": "object",
      "required": ["lab_title", "devices"],
      "properties": {
        "lab_title": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string"},
        "devices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["hostname"],
            "properties": {
              "hostname": {"type": "string", "minLength": 1},
              "api_port": {
                "type": ["integer", "null"],
                "description": "RESTCONF PAT port. null means this device is not reachable over RESTCONF."
              },
              "ssh_port": {"type": ["integer", "null"]},
              "platform": {"type": "string"},
              "role": {"type": "string"},
              "tags": {"type": "array", "items": {"type": "string"}},
              "state": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
