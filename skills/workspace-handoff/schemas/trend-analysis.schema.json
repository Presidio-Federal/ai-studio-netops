{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trend-analysis",
  "title": "trend-analysis.json",
  "description": "Observability's watch state plus the ServiceNow audit trail. Rewritten in full each run; carries baselines forward so the next run can compare.",
  "type": "object",
  "required": [
    "version",
    "updated_at",
    "source_agent",
    "status",
    "headline",
    "next_action",
    "sources",
    "findings"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_agent": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["OK", "DEGRADED", "CRITICAL", "UNKNOWN"],
      "description": "UNKNOWN means a source failed, not that everything is fine."
    },
    "headline": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1},
    "window": {
      "type": "object",
      "properties": {
        "splunk": {"type": "string"},
        "thousandeyes": {"type": "string"}
      }
    },
    "sources": {
      "type": "object",
      "description": "One entry per source consulted. ok=false must be reflected in status.",
      "properties": {
        "splunk": {
          "type": "object",
          "properties": {
            "ok": {"type": ["boolean", "null"]},
            "dashboard": {"type": ["string", "null"]},
            "index": {"type": ["string", "null"]},
            "sourcetype": {"type": ["string", "null"]},
            "critical_error_count": {"type": ["integer", "null"]},
            "top_hosts": {"type": "array"},
            "summary": {"type": "string"}
          }
        },
        "thousandeyes": {
          "type": "object",
          "properties": {
            "ok": {"type": ["boolean", "null"]},
            "tests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "testId": {"type": "string"},
                  "testName": {"type": "string"},
                  "summary": {"type": "string"},
                  "loss_pct_max": {"type": ["number", "null"]},
                  "latency_ms_avg": {"type": ["number", "null"]},
                  "error_rounds": {"type": ["integer", "null"]}
                }
              }
            },
            "summary": {"type": "string"}
          }
        },
        "iosxe": {"type": "object"},
        "compliance": {"type": "object"}
      }
    },
    "findings": {
      "type": "array",
      "description": "Empty is a valid result and means the watch was clean.",
      "items": {
        "type": "object",
        "required": ["id", "severity", "summary"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
          "summary": {"type": "string"},
          "source": {"type": "string"},
          "devices": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "ticket_request": {
      "type": "object",
      "required": ["should_create"],
      "properties": {
        "should_create": {"type": "boolean"},
        "playbook": {"type": ["string", "null"]},
        "fingerprint": {
          "type": ["string", "null"],
          "description": "Stable hash of the condition. Same fingerprint must update the existing incident, never open a second one."
        },
        "short_description": {"type": ["string", "null"]},
        "summary": {"type": ["string", "null"]},
        "recommendation": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "urgency": {"type": ["string", "null"]},
        "impact": {"type": ["string", "null"]},
        "category_hint": {"type": ["string", "null"]},
        "ci_names": {"type": "array"},
        "evidence": {"type": "object"},
        "findings_ids": {"type": "array"},
        "fulfilled_by_incident": {"type": ["string", "null"]}
      }
    },
    "servicenow": {
      "type": "object",
      "properties": {
        "incident": {"type": ["string", "null"]},
        "sys_id": {"type": ["string", "null"]},
        "state": {"type": ["string", "null"]},
        "created_this_run": {"type": "boolean"},
        "updated_this_run": {"type": "boolean"},
        "skipped_reason": {"type": ["string", "null"]},
        "fingerprint": {"type": ["string", "null"]},
        "short_description": {"type": ["string", "null"]}
      }
    },
    "baselines": {
      "type": "object",
      "description": "Carried forward for next-run comparison."
    },
    "remediation_file": {"type": "string"},
    "run": {
      "type": "object",
      "properties": {
        "mode": {"type": "string"},
        "mcp_calls_used": {"type": "integer"}
      }
    }
  }
}
