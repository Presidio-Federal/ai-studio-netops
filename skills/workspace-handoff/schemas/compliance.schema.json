{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance",
  "title": "state/compliance.json",
  "description": "Latest Test run whose scope.suites included compliance. latest is compliance/YYYY-MM-DDTHH-MM-SSZ.json. Do not write this file from reachability/routing/path runs. Do not write a root compliance.json.",
  "type": "object",
  "required": [
    "schema",
    "updated_at",
    "source_agent",
    "status",
    "headline",
    "run",
    "risk",
    "latest"
  ],
  "properties": {
    "schema": {"type": "string", "const": "testing-state/v1"},
    "updated_at": {"type": "string", "minLength": 1},
    "source_agent": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "MIXED", "UNKNOWN", "running"]
    },
    "headline": {"type": "string", "minLength": 1},
    "next_action": {"type": ["string", "null"]},
    "run": {
      "type": "object",
      "properties": {
        "run_id": {"type": ["string", "null"]},
        "html_url": {"type": ["string", "null"]},
        "live_lab": {"type": ["string", "null"]},
        "mode": {"type": ["string", "null"]},
        "suites": {"type": "array", "items": {"type": "string"}}
      }
    },
    "risk": {
      "type": "object",
      "required": ["level", "push_to_prod"],
      "properties": {
        "level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
        "push_to_prod": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "latest": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace-relative path: compliance/YYYY-MM-DDTHH-MM-SSZ.json"
    },
    "gaps": {"type": "array", "items": {"type": "string"}},
    "failing_controls": {"type": ["integer", "null"]},
    "verified_controls": {"type": ["integer", "null"]},
    "failing_devices": {"type": "array", "items": {"type": "string"}}
  }
}
