{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-metadata-netflow/v2",
  "title": "health/metadata-netflow.json",
  "description": "NetFlow SOAP summary (Kind metadata). Health Elastic visit only. Written after the stamp. Lookup fields the next visit needs, the proof path, and four short sentences. Not the row set. Not the tags. Not the five-field envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys", "schema", "updated_at", "source_agent", "netflow"],
  "properties": {
    "keys": {
      "type": "array",
      "maxItems": 0,
      "description": "Empty. Tags live on the stamp."
    },
    "schema": { "type": "string", "const": "health-metadata-netflow/v1" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "health-elastic" },
    "netflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "measurement", "data_stream", "window", "last_visit_id", "last_collected_at", "baseline_visit_id", "proof", "status", "coverage", "delta", "soap"],
      "properties": {
        "data_stream": { "type": "string", "minLength": 1, "description": "ES|QL FROM target. A logs-* stream whose name contains netflow. The same value is copied to measurement." },
        "bucket": { "type": "string", "const": "elasticsearch" },
        "measurement": { "type": "string", "minLength": 1 },
        "firewall_measurement": { "type": ["string", "null"] },
        "window": { "type": "string", "enum": ["15m", "1h", "1d"] },
        "last_visit_id": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$" },
        "last_collected_at": { "type": ["string", "null"] },
        "baseline_visit_id": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$" },
        "proof": { "type": "string", "pattern": "^health/netflow/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z\\.json$", "description": "The stamp that holds this visit's rows, delta, and tags." },
        "status": { "type": "string", "enum": ["ok", "degraded", "unknown"] },
        "coverage": { "type": "string", "enum": ["complete", "partial", "unavailable"] },
        "delta": { "type": "string", "enum": ["first", "unchanged", "worse", "better", "changed"] },
        "identity_review": { "type": "array", "items": { "type": "string" } },
        "exporter_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "entries"],
          "properties": {
            "version": { "type": "integer" },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "identity", "device", "candidates", "configured_export", "expected_activity", "collector_health", "observation_interface"],
                "properties": {
                  "source": { "type": "string" },
                  "identity": { "type": ["string", "null"], "enum": ["resolved", "conflicted", "unverified", null] },
                  "device": { "type": ["string", "null"] },
                  "candidates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["device", "evidence"],
                      "properties": {
                        "device": { "type": "string" },
                        "evidence": { "type": "string" }
                      }
                    }
                  },
                  "configured_export": { "type": ["string", "null"], "enum": ["configured", "not_configured", null] },
                  "expected_activity": { "type": ["string", "null"], "enum": ["expected", "idle_ok", null] },
                  "collector_health": { "type": ["string", "null"], "enum": ["verified", "failing", null] },
                  "observation_interface": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "soap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subjective", "objective", "assessment", "plan"],
          "properties": {
            "subjective": { "type": "string", "minLength": 1, "maxLength": 400, "description": "Why this visit ran." },
            "objective": { "type": "string", "minLength": 1, "maxLength": 400, "description": "What this window measured and how it differs from the prior stamp. Names the proof path. No row table." },
            "assessment": { "type": "string", "minLength": 1, "maxLength": 400, "description": "One verdict. Silence is not a forwarding failure." },
            "plan": { "type": "string", "minLength": 1, "maxLength": 400, "description": "The next check, or none." }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "netflow": { "type": "string", "enum": ["user", "discovered"] } }
    }
  }
}
