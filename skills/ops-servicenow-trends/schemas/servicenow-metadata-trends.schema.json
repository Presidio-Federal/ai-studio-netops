{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "servicenow-metadata-trends/v1",
  "title": "servicenow/metadata-trends.json",
  "description": "Trends lookup (Kind metadata). Groups, categories, match terms, marker. Not the five-field envelope. Live values live here, not in the prompt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "keys", "updated_at", "source_agent", "servicenow"],
  "properties": {
    "schema": { "type": "string", "const": "servicenow-metadata-trends/v1" },
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change):[^ ].*$" }
    },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "ops-servicenow-trends" },
    "servicenow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marker": { "type": ["string", "null"], "minLength": 1 },
        "match_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "assignment_groups": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90,
          "description": "Incident lookback. Default 14."
        },
        "min_related_cases": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "description": "Cluster threshold. Default 3."
        },
        "last_visit_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
        },
        "last_collected_at": { "type": ["string", "null"] }
      }
    },
    "inventory_ref": {
      "type": "string",
      "const": "inventory/prod.json"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servicenow": { "type": "string", "enum": ["user", "discovered"] }
      }
    }
  }
}
