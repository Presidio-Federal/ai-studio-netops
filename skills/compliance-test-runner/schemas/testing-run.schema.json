{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance-run/v1",
  "title": "testing/YYYY-MM-DDTHH-MM-SSZ.json",
  "description": "One general live or static run extract under testing/. Compliance history uses the dedicated compliance-test-visit schema.",
  "type": "object",
  "required": [
    "version",
    "updated_at",
    "source_agent",
    "status",
    "headline",
    "next_action",
    "github_run_id",
    "environment",
    "scope",
    "results",
    "risk"
  ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "compliance-test" },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "MIXED", "UNKNOWN"],
      "description": "MIXED when checks passed but coverage was incomplete."
    },
    "headline": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "github_run_id": { "type": "string", "minLength": 1 },
    "github_run_url": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["live_lab", "lab_role"],
      "properties": {
        "live_lab": { "type": "string", "enum": ["dev", "prod"] },
        "lab_role": { "type": "string", "enum": ["digital_twin", "production"] },
        "note": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["devices_scanned", "suites"],
      "properties": {
        "devices_requested": { "type": "array", "items": { "type": "string" } },
        "devices_scanned": { "type": "array", "items": { "type": "string" } },
        "suites": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "results": {
      "type": "object",
      "required": ["counts_ran"],
      "properties": {
        "counts_ran": {
          "type": "object",
          "required": ["pass", "fail", "error", "skip"],
          "properties": {
            "pass": { "type": "integer" },
            "fail": { "type": "integer" },
            "error": { "type": "integer" },
            "skip": { "type": "integer" }
          }
        },
        "counts_na": { "type": "integer" },
        "ran": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "check", "device", "keys"],
            "properties": {
              "status": { "type": "string", "enum": ["PASS", "FAIL", "ERROR", "SKIP"] },
              "check": { "type": "string" },
              "device": { "type": "string" },
              "keys": {
                "type": "array",
                "minItems": 2,
                "maxItems": 16,
                "uniqueItems": true,
                "description": "Canonical test:<check-id> and exact device key, plus control keys only when the report or published catalog maps them. Strip a known suite/ prefix from the report check for the test key.",
                "items": {
                  "type": "string",
                  "pattern": "^(device|interface|site|service|test|control|incident|change|recommendation):[^ ].*$"
                }
              },
              "detail": { "type": "string" }
            }
          }
        },
        "not_applicable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check", "device", "reason", "keys"],
            "properties": {
              "check": { "type": "string" },
              "device": { "type": "string" },
              "keys": {
                "type": "array",
                "minItems": 2,
                "maxItems": 16,
                "uniqueItems": true,
                "description": "Canonical test:<check-id> and exact device key, plus source-supported control keys.",
                "items": {
                  "type": "string",
                  "pattern": "^(device|interface|site|service|test|control|incident|change|recommendation):[^ ].*$"
                }
              },
              "reason": { "type": "string" }
            }
          }
        },
        "gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk": {
      "type": "object",
      "required": ["level", "push_to_prod", "verdict", "why"],
      "properties": {
        "level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
        "push_to_prod": {
          "type": "string",
          "enum": ["proceed", "proceed_with_caution", "do_not_push", "unknown"]
        },
        "verdict": { "type": "string", "minLength": 1 },
        "why": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "blast_radius": { "type": "string" }
      }
    },
    "local_path": { "type": "string" }
  }
}
