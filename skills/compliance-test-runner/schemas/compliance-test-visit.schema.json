{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance-test-visit/v3",
  "title": "compliance/testing/<stamp>.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keys",
    "schema",
    "visit_id",
    "checked_at",
    "source_agent",
    "status",
    "headline",
    "next_action",
    "github_run_id",
    "github_run_url",
    "environment",
    "scope",
    "results",
    "risk",
    "metrics",
    "vs_prior"
  ],
  "properties": {
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change):[^ ].*$"}
    },
    "schema": {"type": "string", "const": "compliance-test-visit/v3"},
    "visit_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"
    },
    "checked_at": {"type": "string", "format": "date-time"},
    "source_agent": {"type": "string", "const": "compliance-test"},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "MIXED", "UNKNOWN"]},
    "headline": {"type": "string", "minLength": 1},
    "next_action": {"type": "string", "minLength": 1},
    "github_run_id": {"type": "string", "minLength": 1},
    "github_run_url": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "required": ["live_lab", "lab_role"],
      "properties": {
        "live_lab": {"type": "string", "enum": ["dev", "prod"]},
        "lab_role": {"type": "string", "enum": ["digital_twin", "production"]},
        "note": {"type": "string"}
      }
    },
    "scope": {
      "type": "object",
      "required": ["devices_scanned", "suites"],
      "properties": {
        "devices_requested": {"type": "array", "items": {"type": "string"}},
        "devices_scanned": {"type": "array", "items": {"type": "string"}},
        "suites": {"type": "array", "contains": {"const": "compliance"}},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "results": {
      "type": "object",
      "required": ["counts_ran", "counts_by_plane", "ran", "not_applicable", "gaps"],
      "properties": {
        "counts_ran": {
          "$ref": "#/$defs/counts",
          "description": "Sum of counts_by_plane.live and counts_by_plane.static. Taken from the two report count lines, not from the length of ran."
        },
        "counts_by_plane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live", "static"],
          "properties": {
            "live": {"$ref": "#/$defs/counts"},
            "static": {"$ref": "#/$defs/counts"}
          }
        },
        "counts_na": {"type": "integer", "minimum": 0},
        "ran": {
          "type": "array",
          "description": "Failures, errors, skips, and static passes that cleared a prior failure. Other passes stay on the counts.",
          "items": {"$ref": "#/$defs/result_row"}
        },
        "by_device": {
          "type": "array",
          "description": "Failing check ids grouped by device.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device", "failing"],
            "properties": {
              "device": {"type": "string", "minLength": 1},
              "failing": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "not_applicable": {
          "type": "array",
          "items": {"$ref": "#/$defs/na_row"}
        },
        "gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "risk": {
      "type": "object",
      "required": ["level", "push_to_prod", "verdict", "why"],
      "properties": {
        "level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
        "push_to_prod": {"type": "string"},
        "verdict": {"type": "string", "minLength": 1},
        "why": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "blast_radius": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
        "required": ["at", "scope", "visit_id", "environment", "pass", "fail", "error", "skip", "not_applicable", "verified_tests", "failing_tests", "skipped_tests", "tested_posture_pct", "device_check_pass_pct", "planes"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "const": "suite:compliance"},
        "visit_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$"},
        "environment": {"type": "string", "enum": ["dev", "prod"], "description": "environment.live_lab of this visit."},
        "tested_posture_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "100 * verified_tests / (verified_tests + failing_tests), one decimal; null when the denominator is 0."},
        "device_check_pass_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "100 * counts_ran.pass / (pass + fail + error) across both planes, one decimal; null when the denominator is 0."},
        "planes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live", "static"],
          "properties": {
            "live": {"$ref": "#/$defs/plane_metrics"},
            "static": {"$ref": "#/$defs/plane_metrics"}
          }
        },
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0},
        "verified_tests": {"type": "integer", "minimum": 0},
        "failing_tests": {"type": "integer", "minimum": 0},
        "skipped_tests": {"type": "integer", "minimum": 0}
      }
    },
    "vs_prior": {
      "type": "object",
      "additionalProperties": false,
      "description": "Comparison with the last visit in the same environment (metadata last_visit_by_environment). Never compares Dev with prod.",
      "required": ["prior_visit_id", "delta", "newly_passing", "newly_failing", "still_failing", "metrics_delta"],
      "properties": {
        "prior_visit_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z$",
          "description": "Last visit with the same environment.live_lab; null on the first visit in this environment."
        },
        "delta": {
          "type": "string",
          "enum": ["first", "unchanged", "worse", "better", "mixed"],
          "description": "first: no prior. better: newly_passing non-empty, newly_failing empty. worse: newly_failing non-empty, newly_passing empty. mixed: both non-empty. unchanged: both empty."
        },
        "newly_passing": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/flip"}, "description": "Prior FAIL or ERROR, now PASS, same test + device."},
        "newly_failing": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/flip"}, "description": "Prior PASS, now FAIL or ERROR, same test + device."},
        "still_failing": {"type": "integer", "minimum": 0, "description": "Rows FAIL or ERROR in both visits, same test + device."},
        "metrics_delta": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["verified_tests", "failing_tests", "tested_posture_pct", "device_check_pass_pct"],
          "description": "This visit's metric minus the prior's. null on the first visit.",
          "properties": {
            "verified_tests": {"type": "integer"},
            "failing_tests": {"type": "integer"},
            "tested_posture_pct": {"type": ["number", "null"]},
            "device_check_pass_pct": {"type": ["number", "null"]}
          }
        }
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "error", "skip"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0}
      }
    },
    "plane_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "error", "skip", "device_check_pass_pct"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0},
        "device_check_pass_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      }
    },
    "keys": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(device|interface|site|service|test|control|incident|change):[^ ].*$"
      }
    },
    "result_row": {
      "type": "object",
      "required": ["status", "plane", "check", "device", "keys"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FAIL", "ERROR", "SKIP"]},
        "plane": {"type": "string", "enum": ["live", "static"], "description": "Which report block this row came from."},
        "check": {"type": "string"},
        "device": {"type": "string"},
        "keys": {"$ref": "#/$defs/keys"},
        "detail": {"type": "string"}
      }
    },
    "flip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "device", "from", "to", "keys"],
      "properties": {
        "test": {"type": "string", "minLength": 1, "description": "check-id (final segment), as in the row's test: key."},
        "device": {"type": "string", "minLength": 1},
        "from": {"type": "string", "enum": ["PASS", "FAIL", "ERROR"]},
        "to": {"type": "string", "enum": ["PASS", "FAIL", "ERROR"]},
        "keys": {"$ref": "#/$defs/keys"}
      }
    },
    "na_row": {
      "type": "object",
      "required": ["check", "device", "reason", "keys"],
      "properties": {
        "check": {"type": "string"},
        "device": {"type": "string"},
        "reason": {"type": "string"},
        "keys": {"$ref": "#/$defs/keys"}
      }
    }
  }
}
