{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security-run/v1",
  "title": "security/YYYY-MM-DDTHH-MM-SSZ.json",
  "description": "One Caldera traffic operation. Kind result. Envelope plus the operation, the stimulus window, and link outcomes. No command text and no link output.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys", "schema", "updated_at", "source_agent", "status", "headline", "next_action", "operation", "stimulus_window", "agents", "links", "skipped"],
  "properties": {
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change|application):[^ ].*$" }
    },
    "schema": { "type": "string", "const": "security-run/v1" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "caldera-mcp" },
    "status": { "type": "string", "enum": ["running", "finished", "paused", "blocked"] },
    "headline": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string" },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "state", "group", "adversary", "planner", "source", "started"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "state": { "type": "string" },
        "group": { "type": "string" },
        "adversary": { "type": "string" },
        "planner": { "type": "string" },
        "source": { "type": "string" },
        "started": { "type": ["string", "null"] }
      }
    },
    "stimulus_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paw", "host", "device", "group"],
        "properties": {
          "paw": { "type": "string" },
          "host": { "type": "string" },
          "device": { "type": ["string", "null"] },
          "group": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "host", "paw", "ability", "tactic", "technique_id", "status"],
        "properties": {
          "id": { "type": "string" },
          "host": { "type": ["string", "null"] },
          "paw": { "type": ["string", "null"] },
          "ability": { "type": "string" },
          "tactic": { "type": ["string", "null"] },
          "technique_id": { "type": ["string", "null"] },
          "status": { "type": ["integer", "null"] }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
