{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security-metadata/v1",
  "title": "security/metadata.json",
  "description": "Caldera board. Kind metadata. Rewritten every run. Agents enrolled at last read, and the latest operation. No command text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys", "schema", "updated_at", "source_agent", "last_operation_id", "last_collected_at", "agents", "operation"],
  "properties": {
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(device|interface|site|service|test|control|incident|change|application):[^ ].*$" }
    },
    "schema": { "type": "string", "const": "security-metadata/v1" },
    "updated_at": { "type": "string", "minLength": 1 },
    "source_agent": { "type": "string", "const": "caldera-mcp" },
    "last_operation_id": { "type": ["string", "null"] },
    "last_collected_at": { "type": ["string", "null"] },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paw", "host", "group", "platform", "last_seen", "trusted", "device"],
        "properties": {
          "paw": { "type": "string" },
          "host": { "type": "string" },
          "group": { "type": "string" },
          "platform": { "type": "string" },
          "last_seen": { "type": ["string", "null"] },
          "trusted": { "type": "boolean" },
          "device": { "type": ["string", "null"], "description": "inventory/network.json devices[].name when host matched. Else null." }
        }
      }
    },
    "operation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "name", "state", "group", "adversary", "started"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "state": { "type": "string" },
        "group": { "type": "string" },
        "adversary": { "type": "string" },
        "started": { "type": ["string", "null"] }
      }
    }
  }
}
